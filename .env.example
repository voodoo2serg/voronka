# Public HTTPS name. Add an A record to this server before requesting a certificate.
DOMAIN=voronka.familypaper.online
# Host loopback port. Nginx on a shared server proxies here. Do not publish it on 0.0.0.0.
API_PORT=18080
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://funnel:CHANGE_ME@db:5432/funnel
REDIS_URL=redis://redis:6379/0
ADMIN_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Each connection refers to these variable NAMES, never the token itself.
TG_MAIN_TOKEN=
TG_MAIN_WEBHOOK_SECRET=
MAX_MAIN_TOKEN=
MAX_MAIN_WEBHOOK_SECRET=
VK_MAIN_TOKEN=
VK_MAIN_WEBHOOK_SECRET=
VK_MAIN_CONFIRMATION=
VK_API_VERSION=5.199

# CRM browser credentials: docker compose exec api python -m scripts.create_crm_owner
# Robokassa: test invoices never create live money or grant paid access.
ROBOKASSA_LOGIN=
ROBOKASSA_TEST=1
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH=sha256
# Enable only after the shop's separate fiscalization process is configured.
ROBOKASSA_LIVE_READY=0
# SMTP requires STARTTLS; recovery and explicitly launched email campaigns.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Full /api/gateway/v1/chat/completions endpoint, server token, project->model aliases.
RAG_API_URL=
RAG_API_TOKEN=
RAG_PROJECT_MODELS={}
# Optional AI providers (draft-only; never auto-send to clients).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
BOT_MESSAGES_PER_SECOND=20
WORKER_STALE_SECONDS=200
# Neighbor contracts (signed HTTPS only — never share Postgres with solo_pr/lms_end).
DEFAULT_PROJECT_ID=
INTEGRATION_INBOUND_TOKEN=
SOLO_PR_EVENTS_URL=
SOLO_PR_WEBHOOK_SECRET=
LMS_END_ENROLLMENT_URL=
LMS_END_WEBHOOK_SECRET=
LMS_M2M_TOKEN=
# Outreach live unofficial transport stays off unless explicitly enabled.
OUTREACH_MAX_ENABLED=0
# Backup offsite target directory (used by scripts/backup_offsite.sh).
BACKUP_OFFSITE_DIR=
