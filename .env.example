# Public HTTPS name. Add an A record to this server before requesting a certificate.
# VR-433: Activate webhook prefers VORONKA_PUBLIC_URL host over DOMAIN (avoid *.sslip.io —
# Telegram has timed out delivering external /start updates to sslip while solo-pr.ru works).
DOMAIN=voronka.familypaper.online
# VORONKA_PUBLIC_URL=https://voronka.solo-pr.ru
# Host loopback port. Nginx on a shared server proxies here. Do not publish it on 0.0.0.0.
API_PORT=18080
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://funnel:CHANGE_ME@db:5432/funnel
REDIS_URL=redis://redis:6379/0
ADMIN_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Each connection refers to these variable NAMES, never the token itself.
TG_MAIN_TOKEN=
TG_MAIN_WEBHOOK_SECRET=
# Solo-PR course leads (VR-424): @Solo_pr_bot Connection — separate from TG_MAIN_*.
TG_SOLO_PR_TOKEN=
TG_SOLO_PR_WEBHOOK_SECRET=
# Optional override if multiple telegram bots share a project.
# SOLO_PR_TELEGRAM_CONNECTION_ID=
SOLO_PR_CHANNEL_INVITE_URL=https://t.me/+45nxMJzQ-X4wZTUy
# Optional dedicated HMAC for /u/marketing/{token}; falls back to INTEGRATION_INBOUND_TOKEN.
# UNSUBSCRIBE_SIGNING_KEY=
MAX_MAIN_TOKEN=
MAX_MAIN_WEBHOOK_SECRET=
VK_MAIN_TOKEN=
VK_MAIN_WEBHOOK_SECRET=
VK_MAIN_CONFIRMATION=
VK_API_VERSION=5.199

# CRM browser credentials: docker compose exec api python -m scripts.create_crm_owner
# Robokassa: test invoices never create live money or grant paid access.
ROBOKASSA_LOGIN=
ROBOKASSA_TEST=1
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH=sha256
# Fiscal Receipt (54-FZ): sent on payment link; included in SignatureValue.
# Set TAX to the seller's real VAT rate; default none is only for shops without VAT.
ROBOKASSA_RECEIPT_TAX=none
# Optional sno override (osn|usn_income|usn_income_outcome|esn|patent); empty = LK default.
ROBOKASSA_RECEIPT_SNO=
# Optional overrides (defaults: full_prepayment / prepayment for partial; payment_object=service).
ROBOKASSA_RECEIPT_PAYMENT_METHOD=
ROBOKASSA_RECEIPT_PAYMENT_OBJECT=service
# Enable only after fiscal checklist + staging receipt + written owner approval.
# Do not flip from deploy scripts without that approval.
ROBOKASSA_LIVE_READY=0
# Public CRM URL for ResultURL / portal chrome (crm.solo-pr.ru).
CRM_PUBLIC_URL=https://crm.solo-pr.ru
VORONKA_PUBLIC_URL=https://voronka.solo-pr.ru
MAILU_WEBMAIL_URL=https://mail.vodopetov.ru/webmail/
# YooKassa: sandbox OK with shop+secret; YOOKASSA_ENABLED is intent only (no silent live).
YOOKASSA_ENABLED=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
# Optional durable vault file written by CRM payment credentials UI (never commit).
# CRM_PAYMENT_SECRETS_PATH=/run/voronka/payment-secrets.env
# VR-454 Connection Vault: Fernet key (url-safe base64) or auto-persisted key file.
# CRM_SECRETS_FERNET_KEY=
# CRM_SECRETS_FERNET_KEY_PATH=/run/voronka/fernet.key
# Dual-write bot env file for Activate/runtime (never commit).
# CRM_CONNECTION_SECRETS_PATH=/run/voronka/connection-secrets.env
# Optional stable UUID for system Project «Старт» (otherwise auto-seeded).
# CRM_START_PROJECT_ID=
# Constructor From picker extras (comma-separated Mailu identities).
# CRM_MAIL_FROM_IDENTITIES=serg@vodopetov.ru,raga@vodopetov.ru
# Signal media deep-link override for Action Constructor (SSO, no second login).
# SIGNAL_MEDIA_DEEP_LINK=https://signal.vodopetov.ru/?view=media
# Staff payment alert email (falls back to SMTP_FROM).
# STAFF_ALERT_EMAIL=
# SMTP requires STARTTLS; recovery and explicitly launched email campaigns.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Full /api/gateway/v1/chat/completions endpoint, server token, project->model aliases.
RAG_API_URL=
RAG_API_TOKEN=
RAG_PROJECT_MODELS={}
# Optional AI providers (draft-only; never auto-send to clients).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Generic OpenAI-compatible chat completions (vLLM, LiteLLM, local gateway, …).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
BOT_MESSAGES_PER_SECOND=20
WORKER_STALE_SECONDS=200
# Neighbor contracts (signed HTTPS only — never share Postgres with solo_pr/lms_end).
DEFAULT_PROJECT_ID=
INTEGRATION_INBOUND_TOKEN=
# Public solo_pr inbound for deal.paid / access.* (required on VPS).
# Example: https://solo-pr.ru/api/integrations/voronka
SOLO_PR_EVENTS_URL=
# Shared with solo_pr VORONKA_INBOUND_SECRET (voronka→solo) and usually VORONKA_WEBHOOK_SECRET (solo→voronka).
SOLO_PR_WEBHOOK_SECRET=
# CART-04: CMS base for chain cart HMAC consumer (default https://cms.solo-pr.ru).
# SOLO_PR_CMS_URL=https://cms.solo-pr.ru
# Optional full override of cart API URL (default $SOLO_PR_CMS_URL/api/integrations/carts).
# CHAIN_CART_API_URL=
LMS_END_ENROLLMENT_URL=
LMS_END_WEBHOOK_SECRET=
LMS_M2M_TOKEN=
# Signal M2M (СИГНАЛ communications studio) — HMAC wire v1, not crm_session.
SIGNAL_M2M_SECRET=
SIGNAL_M2M_SERVICE_ID=signal
# Comma-separated project ids, or * for any (dev only)
SIGNAL_M2M_PROJECT_ALLOWLIST=
SIGNAL_M2M_SCOPES=campaign:*,asset:read,asset:import,contact:segment:read,connection:hub:read,person:read,timeline:read,timeline:write,consent:write,scenario:*
# Media SoR Wave B — consume Signal Registry asset_id (no second CRM library).
# Prefer Registry presign; Signal internal content is dual-read fallback only.
# Do NOT flip MEDIA_WRITE_ORIGINALS_TO_SIGNAL on Signal host from Voronka.
MEDIA_REGISTRY_URL=
MEDIA_REGISTRY_M2M_SECRET=
MEDIA_REGISTRY_SERVICE_ID=voronka
SIGNAL_INTERNAL_MEDIA_BASE_URL=
SIGNAL_INTERNAL_MEDIA_TOKEN=
# Optional CRM Keycloak browser SSO (AUTH-203). Leave blank until confidential
# client voronka-crm is registered with exact redirect URI (see
# scripts/configure_crm_oidc_client.py). Never commit the client secret.
KEYCLOAK_ISSUER=
CRM_PUBLIC_URL=https://crm.solo-pr.ru
CRM_OIDC_CLIENT_ID=
CRM_OIDC_CLIENT_SECRET=
CRM_OIDC_REDIRECT_URI=https://crm.solo-pr.ru/api/crm/oidc/callback
# After issuer+sub is linked for the existing owner and SSO login is proven,
# set CRM_OIDC_CUTOVER=1 to disable routine local password creation (break-glass
# remains audited). Leave 0 until linked Keycloak login works.
CRM_OIDC_CUTOVER=0
# Optional signed entitlement check against SIGNAL (off until accounts are linked and grants exist).
CRM_APP_ACCESS_ENFORCE=0
SIGNAL_ACCESS_RESOLVE_URL=
SIGNAL_ACCESS_SIGNING_KEY=
# The first user must be linked explicitly by approved admin procedure
# using crm_oidc_links (issuer + subject -> existing crm_accounts.id).
# Example: python -m scripts.link_crm_oidc --subject <kc-sub> --account-id <uuid> --apply
# Optional: Signal delivery webhook target (SIG-10)
# CJ-107: Voronka → Signal CE transactional «доступ открыт» (HMAC source=voronka)
# SIGNAL_EVENTS_URL=https://signal.vodopetov.ru/api/v1/communications/events
# SIGNAL_EVENTS_SECRET=   # must match SIGNAL_EVENT_SOURCE_KEYS.voronka on Signal host
# Outreach live unofficial transport stays off unless explicitly enabled.
OUTREACH_MAX_ENABLED=0
# Backup offsite target directory (used by scripts/backup_offsite.sh).
BACKUP_OFFSITE_DIR=
